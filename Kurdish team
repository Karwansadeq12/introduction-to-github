<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سیستەمی کاروباری پارە</title>
    <style>
        :root {
            --income-color: #2ecc71;
            --expense-color: #e74c3c;
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --background-color: #f8f9fa;
            --card-color: #ffffff;
            --text-color: #2b2d42;
            --light-text: #8d99ae;
            --dark-blue: #1d3557;
        }

        body {
            font-family: 'Tajawal', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--background-color);
            margin: 0;
            padding: 0;
            color: var(--text-color);
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 30px 0;
            text-align: center;
            border-radius: 12px;
            margin-bottom: 40px;
            box-shadow: 0 10px 20px rgba(67, 97, 238, 0.2);
            position: relative;
            overflow: hidden;
        }

        header::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
            transform: rotate(30deg);
        }

        h1 {
            margin: 0;
            font-size: 2.8rem;
            font-weight: 700;
            position: relative;
        }

        header p {
            font-size: 1.2rem;
            opacity: 0.9;
            margin-top: 10px;
            position: relative;
        }

        .dashboard {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .card {
            background-color: var(--card-color);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .balance-card {
            border-top: 5px solid var(--primary-color);
        }

        .income-card {
            border-top: 5px solid var(--income-color);
        }

        .expense-card {
            border-top: 5px solid var(--expense-color);
        }

        .card h2 {
            margin-top: 0;
            font-size: 1.5rem;
            color: var(--dark-blue);
            font-weight: 600;
        }

        .amount {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 15px 0;
        }

        .income-amount {
            color: var(--income-color);
        }

        .expense-amount {
            color: var(--expense-color);
        }

        .transaction-form {
            background-color: var(--card-color);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 40px;
        }

        .transaction-form h2 {
            color: var(--dark-blue);
            margin-top: 0;
            font-size: 1.8rem;
            margin-bottom: 25px;
            position: relative;
            padding-bottom: 10px;
        }

        .transaction-form h2::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            border-radius: 3px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--dark-blue);
        }

        input, select {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            transition: border-color 0.3s, box-shadow 0.3s;
            background-color: #f8f9fa;
        }

        input:focus, select:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
        }

        button {
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            color: white;
            border: none;
            padding: 14px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            transition: all 0.3s;
            width: 100%;
            box-shadow: 0 4px 6px rgba(67, 97, 238, 0.2);
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 14px rgba(67, 97, 238, 0.3);
        }

        .transactions {
            background-color: var(--card-color);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 40px;
        }

        .transactions h2 {
            margin-top: 0;
            color: var(--dark-blue);
            font-size: 1.8rem;
            margin-bottom: 25px;
            position: relative;
            padding-bottom: 10px;
        }

        .transactions h2::after {
            content: "";
            position: absolute;
            bottom: 0;
            right: 0;
            width: 60px;
            height: 3px;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            border-radius: 3px;
        }

        .transaction-list {
            max-height: 500px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .transaction-list::-webkit-scrollbar {
            width: 6px;
        }

        .transaction-list::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .transaction-list::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 10px;
        }

        .transaction-item {
            display: flex;
            justify-content: space-between;
            padding: 18px 0;
            border-bottom: 1px solid #eee;
            transition: background-color 0.3s;
        }

        .transaction-item:hover {
            background-color: #f9f9f9;
        }

        .transaction-item:last-child {
            border-bottom: none;
        }

        .transaction-details {
            flex: 1;
        }

        .transaction-amount {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .income {
            color: var(--income-color);
        }

        .expense {
            color: var(--expense-color);
        }

        .transaction-date {
            color: var(--light-text);
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .transaction-category {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.8rem;
            background-color: #f0f0f0;
            margin-right: 10px;
            font-weight: 500;
        }

        .charts {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-top: 40px;
        }

        .chart-container {
            background-color: var(--card-color);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .chart-container h2 {
            margin-top: 0;
            color: var(--dark-blue);
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .about-section {
            background-color: var(--card-color);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin-top: 50px;
            position: relative;
            overflow: hidden;
        }

        .about-section::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, rgba(67, 97, 238, 0.1) 0%, rgba(67, 97, 238, 0) 70%);
            border-radius: 50%;
        }

        .about-section h2 {
            color: var(--dark-blue);
            font-size: 2rem;
            margin-top: 0;
            margin-bottom: 30px;
            position: relative;
            display: inline-block;
        }

        .about-section h2::after {
            content: "";
            position: absolute;
            bottom: -10px;
            right: 0;
            width: 50%;
            height: 4px;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            border-radius: 2px;
        }

        .about-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-bottom: 40px;
        }

        .about-text {
            padding-right: 20px;
        }

        .about-text p {
            margin-bottom: 20px;
            color: var(--text-color);
        }

        .features {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 30px;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 20px;
        }

        .feature-icon {
            background-color: rgba(67, 97, 238, 0.1);
            color: var(--primary-color);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 15px;
            flex-shrink: 0;
        }

        .feature-text h4 {
            margin: 0 0 5px 0;
            color: var(--dark-blue);
        }

        .feature-text p {
            margin: 0;
            color: var(--light-text);
            font-size: 0.9rem;
        }

        .team-section {
            margin-top: 50px;
        }

        .team-section h3 {
            color: var(--dark-blue);
            font-size: 1.8rem;
            margin-bottom: 30px;
            position: relative;
            display: inline-block;
        }

        .team-section h3::after {
            content: "";
            position: absolute;
            bottom: -10px;
            right: 0;
            width: 40%;
            height: 3px;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
            border-radius: 2px;
        }

        .team-members {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            margin-top: 30px;
        }

        .team-member {
            background-color: var(--card-color);
            border-radius: 12px;
            padding: 25px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s, box-shadow 0.3s;
            position: relative;
            overflow: hidden;
        }

        .team-member:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .team-member::before {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
        }

        .team-member img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            margin-bottom: 20px;
            border: 5px solid rgba(67, 97, 238, 0.1);
            transition: border-color 0.3s;
        }

        .team-member:hover img {
            border-color: rgba(67, 97, 238, 0.3);
        }

        .team-member h4 {
            margin: 10px 0 5px 0;
            color: var(--dark-blue);
            font-size: 1.3rem;
        }

        .team-member p {
            margin: 0;
            color: var(--light-text);
            font-size: 0.9rem;
        }

        .social-links {
            display: flex;
            justify-content: center;
            margin-top: 15px;
            gap: 10px;
        }

        .social-links a {
            color: var(--light-text);
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            background-color: #f0f0f0;
        }

        .social-links a:hover {
            color: white;
            background-color: var(--primary-color);
            transform: translateY(-3px);
        }

        canvas {
            width: 100% !important;
            height: 350px !important;
        }

        @media (max-width: 992px) {
            .about-content {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .dashboard {
                grid-template-columns: 1fr;
            }
            
            .charts {
                grid-template-columns: 1fr;
            }
            
            .features {
                grid-template-columns: 1fr;
            }
            
            .team-members {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>سیستەمی کاروباری پارە</h1>
            <p>بەڕێوەبردنی داهات و خەرجییەکانت بە شێوەیەکی پیشەیی</p>
        </header>

        <div class="dashboard">
            <div class="card balance-card">
                <h2>بڵانسی ئێستا</h2>
                <div class="amount" id="currentBalance">0 دینار</div>
                <p>کۆی گشتی پارە</p>
            </div>

            <div class="card income-card">
                <h2>کۆی داهات</h2>
                <div class="amount income-amount" id="totalIncome">0 دینار</div>
                <p>ئەم مانگە</p>
            </div>

            <div class="card expense-card">
                <h2>کۆی خەرجی</h2>
                <div class="amount expense-amount" id="totalExpense">0 دینار</div>
                <p>ئەم مانگە</p>
            </div>
        </div>

        <div class="transaction-form">
            <h2>مامەڵەی نوێ</h2>
            <div class="form-group">
                <label for="transactionType">جۆری مامەڵە</label>
                <select id="transactionType">
                    <option value="income">داهات</option>
                    <option value="expense">خەرجی</option>
                </select>
            </div>

            <div class="form-group">
                <label for="transactionAmount">بڕ (دینار)</label>
                <input type="number" id="transactionAmount" placeholder="بڕی پارە">
            </div>

            <div class="form-group">
                <label for="transactionDescription">پێناسە</label>
                <input type="text" id="transactionDescription" placeholder="پێناسەی مامەڵە">
            </div>

            <div class="form-group">
                <label for="transactionCategory">بەش</label>
                <select id="transactionCategory">
                    <option value="مووچە">مووچە</option>
                    <option value="فرۆشتنی کاڵا">فرۆشتنی کاڵا</option>
                    <option value="خواردن">خواردن</option>
                    <option value="پێداویستییەکان">پێداویستییەکان</option>
                    <option value="خەرجییەکانی ماڵ">خەرجییەکانی ماڵ</option>
                    <option value="خەرجییەکانی گەشت">خەرجییەکانی گەشت</option>
                    <option value="دیکە">دیکە</option>
                </select>
            </div>

            <button onclick="addTransaction()">تۆمارکردنی مامەڵە</button>
        </div>

        <div class="transactions">
            <h2>مێژووی مامەڵەکان</h2>
            <div class="transaction-list" id="transactionList">
                <!-- مامەڵەکان لێرە دەردەکەون -->
            </div>
        </div>

        <div class="charts">
            <div class="chart-container">
                <h2>دابەشبوونی خەرجییەکان</h2>
                <canvas id="expenseChart"></canvas>
            </div>

            <div class="chart-container">
                <h2>ئاستی داهات و خەرجی</h2>
                <canvas id="incomeExpenseChart"></canvas>
            </div>
        </div>

        <div class="about-section">
            <h2>دەربارەی ئێمە</h2>
            
            <div class="about-content">
                <div class="about-text">
                    <p>سیستەمی کاروباری پارە پڕۆژەیەکی پیشەیییە بۆ بەڕێوەبردنی دارایی کە لەلایەن تیمێکی پسپۆڕی پەرەپێدەرانی کورد دروستکراوە. ئامانجی ئێمە ئەوەیە کە یارمەتی بەکارهێنەرانی سیستەمەکە بدەین لە بەڕێوەبردنی پارە و داراییەکانیان بە شێوەیەکی ئاسان و کاریگەر.</p>
                    
                    <p>ئەم پڕۆژەیە بەشێکە لە پڕۆژەی کۆتایی قوتابیانی کۆلێژی زانستی کۆمپیوتەر لە زانکۆی کۆیە. سیستەمەکە بە تەکنەلۆجیای نوێی وێب دروستکراوە و بە زمانی کوردی خزمەت دەکات.</p>
                    
                    <div class="features">
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-chart-line"></i>
                            </div>
                            <div class="feature-text">
                                <h4>شیکاری دارایی</h4>
                                <p>شیکردنەوەی داهات و خەرجییەکان بە چارت و ڕێژە</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-mobile-alt"></i>
                            </div>
                            <div class="feature-text">
                                <h4>بەکارهێنانی ئاسان</h4>
                                <p>دیزاینی گونجاو بۆ هەموو ئامێرەکان</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="feature-text">
                                <h4>پاراستنی زانیاری</h4>
                                <p>پاراستنی زانیاریەکانت بە شێوەیەکی پاراستە</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-language"></i>
                            </div>
                            <div class="feature-text">
                                <h4>زمانی کوردی</h4>
                                <p>یەکەم سیستەمی بەڕێوەبردنی پارە بە زمانی کوردی</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="about-image">
                    <img src="https://via.placeholder.com/500x400" alt="دەربارەی سیستەم" style="width: 100%; border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,0.1);">
                </div>
            </div>
            
            <div class="team-section">
                <h3>تیمی پڕۆژەکە</h3>
                
                <div class="team-members">
                    <div class="team-member">
                        <img src="https://via.placeholder.com/150" alt="کاروان سەدیق">
                        <h4>کاروان سەدیق</h4>
                        <p>پەرەپێدەری سەرەکی</p>
                        <div class="social-links">
                            <a href="#"><i class="fab fa-twitter"></i></a>
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                            <a href="#"><i class="fab fa-github"></i></a>
                        </div>
                    </div>
                    
                    <div class="team-member">
                        <img src="https://via.placeholder.com/150" alt="هێمن عەلی">
                        <h4>هێمن عەلی</h4>
                        <p>دیزاینەری ڕووکار</p>
                        <div class="social-links">
                            <a href="#"><i class="fab fa-twitter"></i></a>
                            <a href="#"><i class="fab fa-behance"></i></a>
                            <a href="#"><i class="fab fa-dribbble"></i></a>
                        </div>
                    </div>
                    
                    <div class="team-member">
                        <img src="https://via.placeholder.com/150" alt="سارا محەممەد">
                        <h4>سارا محەممەد</h4>
                        <p>پەرەپێدەری بەک-ئێند</p>
                        <div class="social-links">
                            <a href="#"><i class="fab fa-linkedin"></i></a>
                            <a href="#"><i class="fab fa-github"></i></a>
                            <a href="#"><i class="fab fa-medium"></i></a>
                        </div>
                    </div>
                    
                    <div class="team-member">
                        <img src="https://via.placeholder.com/150" alt="ڕەوان عەزیز">
                        <h4>ڕەوان عەزیز</h4>
                        <p>تاقیکەرەوە</p>
                        <div class="social-links">
                            <a href="#"><i class="fab fa-twitter"></i></a>
                            <a href="#"><i class="fab fa-github"></i></a>
                            <a href="#"><i class="fab fa-stack-overflow"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="contact-info" style="margin-top: 50px; text-align: center;">
                <p style="font-size: 1.1rem; color: var(--dark-blue); font-weight: 600;">بۆ پەیوەندی و پرسیارەکان:</p>
                <p style="margin-top: 10px;">
                    <i class="fas fa-envelope" style="color: var(--primary-color); margin-left: 10px;"></i>
                    <a href="mailto:info@moneyapp.com" style="color: var(--text-color); text-decoration: none;">info@moneyapp.com</a>
                </p>
                <p style="margin-top: 10px;">
                    <i class="fas fa-map-marker-alt" style="color: var(--primary-color); margin-left: 10px;"></i>
                    زانکۆی کۆیە، هەولێر، کوردستان
                </p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // داتاکان
        let transactions = JSON.parse(localStorage.getItem('transactions')) || [];
        let currentBalance = 0;
        let totalIncome = 0;
        let totalExpense = 0;

        // چارتەکان
        let expenseChart;
        let incomeExpenseChart;

        // فەرمانی سەرەتا
        document.addEventListener('DOMContentLoaded', function() {
            updateDashboard();
            renderTransactionList();
            renderCharts();
        });

        // زیادکردنی مامەڵەی نوێ
        function addTransaction() {
            const type = document.getElementById('transactionType').value;
            const amount = parseFloat(document.getElementById('transactionAmount').value);
            const description = document.getElementById('transactionDescription').value;
            const category = document.getElementById('transactionCategory').value;

            if (!amount || isNaN(amount)) {
                alert('تکایە بڕی پارە بنووسە!');
                return;
            }

            if (!description) {
                alert('تکایە پێناسەی مامەڵە بنووسە!');
                return;
            }

            const transaction = {
                id: Date.now(),
                type: type,
                amount: amount,
                description: description,
                category: category,
                date: new Date().toLocaleDateString('ku-IQ')
            };

            transactions.push(transaction);
            saveTransactions();
            updateDashboard();
            renderTransactionList();
            renderCharts();

            // پاککردنەوەی خانەکان
            document.getElementById('transactionAmount').value = '';
            document.getElementById('transactionDescription').value = '';
        }

        // نوێکردنەوەی داشبۆرد
        function updateDashboard() {
            currentBalance = 0;
            totalIncome = 0;
            totalExpense = 0;

            const currentMonth = new Date().getMonth();
            const currentYear = new Date().getFullYear();

            transactions.forEach(transaction => {
                const transactionDate = new Date(transaction.id);
                if (transactionDate.getMonth() === currentMonth && transactionDate.getFullYear() === currentYear) {
                    if (transaction.type === 'income') {
                        totalIncome += transaction.amount;
                    } else {
                        totalExpense += transaction.amount;
                    }
                }

                if (transaction.type === 'income') {
                    currentBalance += transaction.amount;
                } else {
                    currentBalance -= transaction.amount;
                }
            });

            document.getElementById('currentBalance').textContent = currentBalance.toLocaleString() + ' دینار';
            document.getElementById('totalIncome').textContent = totalIncome.toLocaleString() + ' دینار';
            document.getElementById('totalExpense').textContent = totalExpense.toLocaleString() + ' دینار';
        }

        // پیشاندانی لیستی مامەڵەکان
        function renderTransactionList() {
            const transactionList = document.getElementById('transactionList');
            transactionList.innerHTML = '';

            if (transactions.length === 0) {
                transactionList.innerHTML = '<p style="text-align: center; color: var(--light-text);">هیچ مامەڵەیەک تۆمارنەکراوە</p>';
                return;
            }

            // ڕیزکردنی مامەڵەکان بەپێی کاتی
            const sortedTransactions = transactions.slice().sort((a, b) => b.id - a.id);

            sortedTransactions.forEach(transaction => {
                const transactionItem = document.createElement('div');
                transactionItem.className = 'transaction-item';

                const details = document.createElement('div');
                details.className = 'transaction-details';

                const title = document.createElement('div');
                title.textContent = transaction.description;
                title.style.fontWeight = 'bold';

                const date = document.createElement('div');
                date.className = 'transaction-date';
                date.textContent = transaction.date;

                const category = document.createElement('span');
                category.className = 'transaction-category';
                category.textContent = transaction.category;

                details.appendChild(title);
                details.appendChild(date);

                const amount = document.createElement('div');
                amount.className = `transaction-amount ${transaction.type}`;
                amount.textContent = (transaction.type === 'income' ? '+' : '-') + 
                                    transaction.amount.toLocaleString() + ' دینار';
                amount.appendChild(category);

                transactionItem.appendChild(details);
                transactionItem.appendChild(amount);

                transactionList.appendChild(transactionItem);
            });
        }

        // دروستکردنی چارتەکان
        function renderCharts() {
            // چارتی دابەشبوونی خەرجییەکان
            const expenseCtx = document.getElementById('expenseChart').getContext('2d');
            
            // کۆکردنەوەی داتای خەرجی بۆ چارت
            const expenseCategories = {};
            transactions.forEach(transaction => {
                if (transaction.type === 'expense') {
                    if (expenseCategories[transaction.category]) {
                        expenseCategories[transaction.category] += transaction.amount;
                    } else {
                        expenseCategories[transaction.category] = transaction.amount;
                    }
                }
            });

            const expenseLabels = Object.keys(expenseCategories);
            const expenseData = Object.values(expenseCategories);

            if (expenseChart) {
                expenseChart.destroy();
            }

            expenseChart = new Chart(expenseCtx, {
                type: 'doughnut',
                data: {
                    labels: expenseLabels,
                    datasets: [{
                        data: expenseData,
                        backgroundColor: [
                            '#4361ee',
                            '#3f37c9',
                            '#4895ef',
                            '#4cc9f0',
                            '#560bad',
                            '#7209b7'
                        ],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            rtl: true,
                            labels: {
                                usePointStyle: true,
                                padding: 20
                            }
                        }
                    },
                    cutout: '70%'
                }
            });

            // چارتی داهات و خەرجی
            const incomeExpenseCtx = document.getElementById('incomeExpenseChart').getContext('2d');
            
            // کۆکردنەوەی داتا بۆ 6 مانگی پێشوو
            const months = [];
            const incomeData = [];
            const expenseDataMonthly = [];

            for (let i = 5; i >= 0; i--) {
                const date = new Date();
                date.setMonth(date.getMonth() - i);
                
                const monthName = date.toLocaleDateString('ku-IQ', { month: 'long' });
                months.push(monthName);
                
                let monthIncome = 0;
                let monthExpense = 0;
                const month = date.getMonth();
                const year = date.getFullYear();
                
                transactions.forEach(transaction => {
                    const transactionDate = new Date(transaction.id);
                    if (transactionDate.getMonth() === month && transactionDate.getFullYear() === year) {
                        if (transaction.type === 'income') {
                            monthIncome += transaction.amount;
                        } else {
                            monthExpense += transaction.amount;
                        }
                    }
                });
                
                incomeData.push(monthIncome);
                expenseDataMonthly.push(monthExpense);
            }

            if (incomeExpenseChart) {
                incomeExpenseChart.destroy();
            }

            incomeExpenseChart = new Chart(incomeExpenseCtx, {
                type: 'bar',
                data: {
                    labels: months,
                    datasets: [
                        {
                            label: 'داهات',
                            data: incomeData,
                            backgroundColor: 'rgba(46, 204, 113, 0.7)',
                            borderColor: 'rgba(46, 204, 113, 1)',
                            borderWidth: 1,
                            borderRadius: 6
                        },
                        {
                            label: 'خەرجی',
                            data: expenseDataMonthly,
                            backgroundColor: 'rgba(231, 76, 60, 0.7)',
                            borderColor: 'rgba(231, 76, 60, 1)',
                            borderWidth: 1,
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                drawBorder: false
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            rtl: true,
                            labels: {
                                usePointStyle: true,
                                padding: 20
                            }
                        }
                    }
                }
            });
        }

        // پاشەکەوتکردنی مامەڵەکان
        function saveTransactions() {
            localStorage.setItem('transactions', JSON.stringify(transactions));
        }
    </script>
</body>
</html>
